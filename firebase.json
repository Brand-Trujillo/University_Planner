{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "functions/**", "firestore.rules", ".firebaserc", ".gitignore", "*.md"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": [{ "source": "functions", "codebase": "default", "ignore": ["node_modules", ".git"] }]
}
