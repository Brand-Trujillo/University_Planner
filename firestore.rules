rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo lee y escribe su propio documento
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    // Dispositivos registrados para avisos push (solo el dueño)
    match /users/{uid}/tokens/{token} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Chat por código de grupo: cualquier usuario con sesión puede leer y enviar; no se edita ni borra
    match /groups/{code}/messages/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['room', 'author', 'uid', 'text', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
    }
  }
}
